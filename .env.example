# SafeRoute / MargNova Environment Variables (Local Development)

# Server Ports
PORT=8080
PYTHON_PORT=8000
FRONTEND_PORT=5173

# Python Intelligence Service Internal Authentication
INTERNAL_SERVICE_KEY=dev-internal-secret-key-saferoute-2026
INTELLIGENCE_URL=http://localhost:8000

# Weather Provider Integration (Open-Meteo API)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Frontend Origin for Centralized CORS Protection
FRONTEND_ORIGIN=http://localhost:5173

# Database Configuration
# Profile 'local' uses in-memory PostgreSQL-compatible mode with Flyway
# Profile 'postgres' connects to local PostgreSQL instance
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saferoute
DB_USERNAME=saferoute_user
DB_PASSWORD=saferoute_pass


# Pedestrian routing fallback. The routed-foot prefix selects the walking graph.
OSRM_URL=https://routing.openstreetmap.de/routed-foot
# Optional OpenRouteService key. ORS is attempted before the public fallback.
ORS_API_KEY=
